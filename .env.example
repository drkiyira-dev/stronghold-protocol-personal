# Optional server-only tactical coach. Local analysis works without these.
# Full Chat Completions-compatible endpoint; choose your provider and model.
COACH_API_URL=https://api.openai.com/v1/chat/completions
COACH_API_KEY=
COACH_MODEL=
# Set a separate strong access token for your personal coach endpoint.
COACH_ACCESS_TOKEN=
# Comma-separated exact browser origins allowed to call the coach.
COACH_ALLOWED_ORIGINS=

# Extra exact origins for a different room/coach host in the self-hosted page CSP.
PERSONAL_CONNECT_ORIGINS=

# Optional R1 room durability. Empty keeps rooms in process memory.
# Use a private local directory (not a network filesystem).
PERSONAL_STATE_DIR=
# Exact origins for recovery registration/confirmation from another frontend.
PERSONAL_ALLOWED_ORIGINS=
